#!/usr/bin/env bash

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
failures=0
stow_target=""

pass() {
  printf 'PASS  %s\n' "$1"
}

fail() {
  printf 'FAIL  %s\n' "$1" >&2
  failures=$((failures + 1))
}

skip() {
  printf 'SKIP  %s\n' "$1"
}

check() {
  local label="$1"
  shift
  if "$@"; then
    pass "$label"
  else
    fail "$label"
  fi
}

check_git_config() {
  git config --file "$SCRIPT_DIR/dotfiles/.gitconfig" --list >/dev/null
}

check_json_files() {
  ruby -rjson -e 'ARGV.each { |path| JSON.parse(File.read(path)) }' "$@"
}

check_powershell_syntax() {
  # shellcheck disable=SC2016
  POWERSHELL_PROFILE="$SCRIPT_DIR/dotfiles/.config/powershell/Microsoft.PowerShell_profile.ps1" \
    pwsh -NoLogo -NoProfile -NonInteractive -Command '
      $tokens = $null
      $errors = $null
      [System.Management.Automation.Language.Parser]::ParseFile(
        $env:POWERSHELL_PROFILE,
        [ref]$tokens,
        [ref]$errors
      ) | Out-Null
      if ($errors.Count) { exit 1 }
    '
}

check_stow_simulation() {
  stow --simulate --verbose=1 --no-folding --ignore='\.DS_Store' \
    -d "$SCRIPT_DIR/dotfiles" -t "$stow_target" . >/dev/null 2>&1
}

cleanup() {
  if [[ -n "$stow_target" ]]; then
    rmdir -- "$stow_target" 2>/dev/null || true
  fi
}
trap cleanup EXIT

shopt -s nullglob
shell_scripts=(
  "$SCRIPT_DIR"/*.sh
  "$SCRIPT_DIR"/scripts/*.sh
  "$SCRIPT_DIR"/scripts/doctor
)
zsh_files=(
  "$SCRIPT_DIR/dotfiles/.zprofile"
  "$SCRIPT_DIR/dotfiles/.zshrc"
  "$SCRIPT_DIR/dotfiles/.config/zsh/"*.zsh
)

check "bootstrap scripts are executable" test -x "$SCRIPT_DIR/install.sh" \
  -a -x "$SCRIPT_DIR/stow.sh" -a -x "$SCRIPT_DIR/scripts/doctor"
check "Bash syntax" bash -n "${shell_scripts[@]}"
check "Zsh syntax" zsh -n "${zsh_files[@]}"
if command -v ruby >/dev/null 2>&1; then
  check "Brewfile syntax" ruby -c "$SCRIPT_DIR/Brewfile"
  check "VS Code settings JSON" check_json_files \
    "$SCRIPT_DIR/dotfiles/Library/Application Support/Code/User/settings.json" \
    "$SCRIPT_DIR/dotfiles/Library/Application Support/Code/User/keybindings.json"
else
  skip "Ruby is not installed (Brewfile syntax unavailable)"
fi
check "Git config parses" check_git_config
check "Git whitespace check" git -C "$SCRIPT_DIR" diff --check

if command -v shellcheck >/dev/null 2>&1; then
  check "ShellCheck" shellcheck "${shell_scripts[@]}"
else
  skip "ShellCheck is not installed"
fi

if command -v shfmt >/dev/null 2>&1; then
  check "Shell formatting" shfmt -d "${shell_scripts[@]}"
else
  skip "shfmt is not installed"
fi

if command -v pwsh >/dev/null 2>&1; then
  check "PowerShell syntax" check_powershell_syntax
else
  skip "PowerShell is not installed"
fi

if command -v stow >/dev/null 2>&1; then
  stow_target="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-stow.XXXXXX")"
  check "GNU Stow simulation" check_stow_simulation
else
  skip "GNU Stow is not installed"
fi

if command -v brew >/dev/null 2>&1; then
  if brew bundle check --file="$SCRIPT_DIR/Brewfile" >/dev/null 2>&1; then
    pass "Homebrew bundle is satisfied"
  else
    skip "Homebrew bundle has local dependency drift"
  fi
else
  skip "Homebrew is not installed"
fi

if ((failures)); then
  printf '\n%d check(s) failed.\n' "$failures" >&2
  exit 1
fi

printf '\nAll checks passed.\n'
