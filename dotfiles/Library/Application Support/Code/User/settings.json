{
  "[go]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "golang.go"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[opentofu][opentofu-vars]": {
    "editor.defaultFormatter": "opentofu.vscode-opentofu"
  },
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell"
  },
  "[proto]": {
    "editor.defaultFormatter": "bufbuild.vscode-buf"
  },
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[shellscript][dockerfile][dotenv][ignore][properties][hosts]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[vue]": {
    "editor.defaultFormatter": "Vue.volar"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "buf.commandLine.path": "/opt/homebrew/bin/buf",
  "chat.disableAIFeatures": true,
  "chat.editor.fontSize": 14,
  "debug.console.fontFamily": "Cascadia Code NF, Cascadia Code, Consolas, 'Courier New', monospace",
  "debug.console.fontSize": 14,
  "editor.fontFamily": "Cascadia Code NF, Cascadia Code, Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.inlineSuggest.enabled": true,
  "editor.mouseWheelZoom": true,
  "editor.tabSize": 2,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.axaml": "${capture}.axaml.cs",
    "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json",
    "*.cshtml": "${capture}.cshtml.cs,${capture}.cshtml.css",
    "*.csproj": "${capture}.csproj.user",
    "*.db": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.razor": "${capture}.razor.cs,${capture}.razor.css",
    "*.resx": "${capture}.Designer.cs",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
    "*.sqlite": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.ts": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "*.xaml": "${capture}.xaml.cs",
    "Cargo.toml": "Cargo.lock",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "tsconfig.json": "tsconfig.*.json"
  },
  "files.associations": {
    "*.hcl": "opentofu",
    "*.slnx": "xml",
    "*.yaml": "yaml"
  },
  "files.insertFinalNewline": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": false,
  "git.openRepositoryInParentFolders": "always",
  "git.replaceTagsWhenPull": true,
  "githubPullRequests.pullBranch": "never",
  "githubPullRequests.pushBranch": "always",
  "go.alternateTools": {
    "dlv": "/opt/homebrew/bin/dlv",
    "gopls": "/opt/homebrew/bin/gopls"
  },
  "markdown.preview.fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe WPC', 'Segoe UI', system-ui, 'Ubuntu', 'Droid Sans', sans-serif",
  "opentofu.languageServer.tofu.path": "/Users/joshuaw/.local/share/mise/installs/opentofu/latest/tofu",
  "powershell.powerShellAdditionalExePaths": {
    "PowerShell 7 (mise)": "/Users/joshuaw/.local/share/mise/installs/powershell/latest/pwsh"
  },
  "powershell.powerShellDefaultVersion": "PowerShell 7 (mise)",
  "powershell.codeFormatting.trimWhitespaceAroundPipe": true,
  "powershell.codeFormatting.useCorrectCasing": true,
  "powershell.codeFormatting.autoCorrectAliases": true,
  "powershell.codeFormatting.whitespaceBetweenParameters": true,
  "powershell.promptToUpdatePowerShell": false,
  "redhat.telemetry.enabled": false,
  "security.workspace.trust.untrustedFiles": "prompt",
  "shellformat.path": "/opt/homebrew/bin/shfmt",
  "shellformat.useEditorConfig": true,
  "terminal.integrated.fontFamily": "Cascadia Code NF, Cascadia Code, Consolas, 'Courier New', monospace",
  "terminal.integrated.fontSize": 14,
  "vs-kubernetes": {
    "vs-kubernetes.crd-code-completion": "enabled"
  },
  "workbench.colorTheme": "GitHub Dark Default",
  "workbench.iconTheme": "bearded-icons",
  "workbench.startupEditor": "none",
  "yaml.disableSchemaDetection": [
    "**/.forgejo/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.github/workflows/*.yml"
  ]
}
